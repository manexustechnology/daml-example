-- DAML by Example | 06 - IOU (a token / asset)
--
-- The canonical DAML asset. An IOU ("I owe you") is an issuer's promise of
-- an amount to an owner. Compare to an ERC20 balance, but with two key
-- differences:
--   * Each holding is its OWN contract (not a row in a shared mapping).
--   * Transfers use propose/accept, so the recipient consents to receiving.
--
-- This file combines everything so far: signatory/observer, choices with
-- arguments, ensure, assertMsg, fetch, archive, and propose/accept.
module Apps.Iou where

import Daml.Script
import DA.Assert ((===))

template Iou
  with
    issuer : Party
    owner  : Party
    amount : Decimal
  where
    ensure amount > 0.0          -- no zero/negative holdings
    signatory issuer             -- the issuer stands behind the promise
    observer owner               -- the owner can see and act on it

    -- Split one holding into two (e.g. to pay part of a balance).
    choice Split : (ContractId Iou, ContractId Iou)
      with splitAmount : Decimal
      controller owner
      do
        assertMsg "split must be > 0 and < amount"
          (splitAmount > 0.0 && splitAmount < amount)
        a <- create this with amount = splitAmount
        b <- create this with amount = amount - splitAmount
        pure (a, b)

    -- Merge another holding (same issuer + owner) into this one.
    choice Merge : ContractId Iou
      with otherCid : ContractId Iou
      controller owner
      do
        other <- fetch otherCid          -- read the other contract's data
        assertMsg "can only merge same issuer and owner"
          (other.issuer == issuer && other.owner == owner)
        archive otherCid                 -- consume the other holding
        create this with amount = amount + other.amount

    -- Transfer = PROPOSE a new owner. Nothing moves until they accept.
    choice ProposeTransfer : ContractId IouTransfer
      with newOwner : Party
      controller owner
      do create IouTransfer with iou = this, newOwner

-- The transfer proposal. Signed by the current stakeholders; the prospective
-- new owner observes it and decides.
template IouTransfer
  with
    iou : Iou
    newOwner : Party
  where
    signatory iou.issuer, iou.owner
    observer newOwner

    choice AcceptTransfer : ContractId Iou
      controller newOwner
      do create (iou with owner = newOwner)   -- reissue to the new owner

    choice RejectTransfer : ContractId Iou
      controller newOwner
      do create iou                            -- recreate unchanged

test : Script ()
test = script do
  bank  <- allocateParty "Bank"
  alice <- allocateParty "Alice"
  bob   <- allocateParty "Bob"

  -- Bank issues 100 to Alice.
  iou <- submit bank do
    createCmd Iou with issuer = bank, owner = alice, amount = 100.0

  -- Alice splits off 30 (leaving herself 70).
  (small, _big) <- submit alice do exerciseCmd iou Split with splitAmount = 30.0

  -- Alice transfers the 30 to Bob: she proposes, Bob accepts.
  xfer   <- submit alice do exerciseCmd small ProposeTransfer with newOwner = bob
  bobIou <- submit bob   do exerciseCmd xfer AcceptTransfer

  -- Verify Bob now holds 30.
  Some bobHolding <- queryContractId bob bobIou
  bobHolding.owner  === bob
  bobHolding.amount === 30.0

  pure ()
